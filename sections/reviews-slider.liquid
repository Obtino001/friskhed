
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

#shopify-section-{{ section.id }} .rev-section {
  background-color: {{ section.settings.bg_color }};
  overflow: hidden;
}
.rev-heading {
  font-size: 42px;
  font-weight: 500;
  line-height: 1.1;
  color: #000000;
  margin-bottom: 40px;
  letter-spacing: -0.02em;
}

.rev-container {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

.rev-left {
    min-width: 400px;
    flex-shrink: 0;
    background: #D9D9D933;
    border-radius: 10px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    max-height: 248px;
    min-height: 248px;
}
.rev-summary-title {
  font-weight: 600;
  font-style: ExtraBold;
  font-size: 22px;

  line-height: 100%;
  margin-bottom: 18px;
  letter-spacing: 0%;
}
.rev-summary-text p{
margin: 0;
}
.rev-summary-text {
  font-size: 15px;
  line-height: 1.5;
  color: #333;
  font-weight: 500;
  margin-top: 12px;
}

.rev-trustpilot-logo {
  display: flex;
  align-items: center;
  gap: 2px;
  margin-top: auto; /* Pushes to bottom */
  padding-top: 18px;
}

.rev-trustpilot-logo svg {
  width: 24px;
  height: 24px;
  fill: #00B67A;
}

.rev-trustpilot-text {
  font-weight: 500;
  font-size: 14px;
  color: #000;
}
.rev-author-cc {
  display: flex;
  align-items: center;
  gap: 10px;
  justify-content: space-between;
}
.swiper-container-{{ section.id }} {
  width: 100%;
  height: 100%;
  padding-bottom: 50px !important; 
}
.swiper-slide.rev-card {
    background: #D9D9D933;
    border-radius: 10px;
    padding: 24px;
    height: auto;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: 248px;
    max-height: 248px;
    gap: 15px;
}
.rev-author {
font-weight: 500;
font-style: Medium;
font-size: 14px;
line-height: 22px;
letter-spacing: 0%;
Color: #000000;
}

.rev-subinfo {
font-weight: 500;
font-style: Medium;
font-size: 16px;
line-height: 22px;
letter-spacing: 0%;
Color: #000000;

}

.rev-stars-row {
  display: flex;
  gap: 2px;
  /* margin-bottom: 16px; */
  /* flex-direction: column; */
}
.rev-green-star {
  width: 16px;
  height: 16px;
  background-color: #00B67A; 
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 2px;
}

.rev-green-star svg {
  width: 14px;
  height: 14px;
  fill: #fff;
}

.rev-headline {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 8px;
  color: #000;
}

.rev-content {
font-weight: 400;
font-style: Regular;
font-size: 14px;
line-height: 22px;
letter-spacing: 0%;
color: #000000;
}

.rev-nav-container {
  display: flex;
  justify-content: flex-end; 
  gap: 12px;
  margin-top: -30px; 
  padding-right: 18px;
  position: relative;
  z-index: 2;
}

.rev-nav-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
 border: 1px solid #000000;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
  color: {{ section.settings.arrow_color }};
}

.rev-nav-btn:hover {
  border-color: #000;
  background: #F5F5F7;
}
img.title-ts-image {
  height: 29px;
  width: 153px;
  object-fit: contain;
}
.rev-right {
flex: 1;
min-width: 0; 
position: relative;
overflow: hidden; /* <--- CRITICAL FIX */
width: 100%;      /* <--- CRITICAL FIX */
}
.rev-nav-btn svg {
  width: 18px;
  height: 18px;
  stroke: #000;
}
/* Progress Bar */

  .swiper-pagination-{{ section.id }} {
    position: relative; /* Or absolute, depending on your layout */
    height: 4px;        /* Thickness of the line */
    background: #e0e0e0; /* Gray background for the empty part */
    width: 100%;
    border-radius: 2px;
    overflow: hidden;
  }

  /* The filling part of the bar */
  .swiper-pagination-{{ section.id }} .swiper-pagination-progressbar-fill {
    background: {{ section.settings.progress_color }}; /* Your schema color */
    height: 100%;
    display: block;
    transition: transform 300ms; /* Smooth movement */
  }

.rev-nav-group {
  display: flex;
  gap: 12px;
  flex-shrink: 0;
}



.rev-nav-btn:hover {
  border-color: {{ section.settings.arrow_color }};
  background: #F5F5F7;
}
.rev-bottom-controls {
  display: flex;
  align-items: center;
  gap: 40px;
}
.rev-nav-btn svg {
  width: 18px;
  height: 18px;
  stroke: currentColor;
}
@media screen and (max-width: 500px) {
.rev-heading {
    font-size: 26px;
    text-align: left;
    line-height: 140%;
}
.rev-container { flex-direction: column; }
.rev-left { width: 100%; min-height: auto;  }
.rev-right { width: 100%; } 
.rev-nav-container { justify-content: center; margin-top: 10px; }
.swiper-scrollbar-{{ section.id }} {
width: 100%;
}
.rev-bottom-controls {
    gap: 18px;
}
.swiper-container-{{ section.id }} {
padding-bottom: 30px !important; 
}
.rev-nav-group {
justify-content: center;
}
}
{%- endstyle -%}

<div class="rev-section section-{{ section.id }}-padding">
  <div class="rev-main-wrapper container-x">
    
    <div class="rev-container">
      
      <div class="rev-left">
          <div class="rev-summary-title">{{ section.settings.summary_title }}</div>
          
          <div class="rev-stars-row">
            {% if section.settings.stars_image != blank %}
               <img class="title-ts-image" src="{{ section.settings.stars_image | image_url: width: 1200 }}" alt="5 stars">
            {% else %}
               {%- for i in (1..5) -%}
                 <div class="rev-green-star">
                   <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                 </div>
               {%- endfor -%}
            {% endif %}
          </div>

          <div class="rev-summary-text">
            <p>{% render 'trustpilot-claim' %}</p>
          </div>
          <div class="rev-trustpilot-logo">
            <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
            <span class="rev-trustpilot-text">{{ section.settings.trust_text }}</span>
          </div>
      </div>

      <div class="rev-right">
        <div class="swiper swiper-container-{{ section.id }}">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide rev-card" {{ block.shopify_attributes }}>
                 <div class="rev-author-cc">
                    <div class="rev-author">{{ block.settings.author }}</div>
                    
                    <div class="rev-stars-row">
                      {% if block.settings.stars_image != blank %}
                          <img src="{{ block.settings.stars_image | image_url: width: 1200 }}" alt="5 stars" style="height: 18px; object-fit: contain;">
                      {% else %}
                          {%- for i in (1..5) -%}
                            <div class="rev-green-star">
                              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                            </div>
                          {%- endfor -%}
                      {% endif %}
                    </div>
                 </div>

                {% if block.settings.headline != blank %}
                   <div class="rev-headline">{{ block.settings.headline }}</div>
                {% endif %}
                
                <div class="rev-content">{{ block.settings.content }}</div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

    </div>

    <div class="rev-bottom-controls">
      
      <div class="swiper-pagination-{{ section.id }} swiper-pagination-progressbar"></div>

      <div class="rev-nav-group">
        <div class="rev-nav-btn" id="prev-btn-{{ section.id }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </div>
        <div class="rev-nav-btn" id="next-btn-{{ section.id }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </div>
      </div>

    </div>

  </div>
</div>



<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.swiper-container-{{ section.id }}', {
      slidesPerView: 1, 
      spaceBetween: 10,
      loop: false, 
      
      {% if section.settings.autoplay %}
      autoplay: {
        delay: {{ section.settings.autoplay_speed }},
        disableOnInteraction: false,
      },
      {% endif %}

      navigation: {
        nextEl: '#next-btn-{{ section.id }}',
        prevEl: '#prev-btn-{{ section.id }}',
      },

      // --- CHANGED HERE: Use Pagination 'progressbar' instead of Scrollbar ---
      pagination: {
        el: '.swiper-pagination-{{ section.id }}',
        type: 'progressbar',
      },
      // ---------------------------------------------------------------------

      breakpoints: {
        768: {
          slidesPerView: 2,
          spaceBetween: 10
        },
        1024: {
          slidesPerView: 2,
          spaceBetween: 10
        },
         1324: {
          slidesPerView: 3,
          spaceBetween: 10
        },
           1624: {
          slidesPerView: 3,
          spaceBetween: 10
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Trustpilot Style Slider",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F9F9"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Derfor vælger kunder Friskhed"
    },
    {
      "type": "header",
      "content": "Summary Card (Left)"
    },
    {
      "type": "text",
      "id": "summary_title",
      "label": "Summary Title",
      "default": "Friskhed.dk"
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Rating Stats Text",
      "default": "<p>4,9 på Trustpilot · 469 anmeldelser</p>"
    },
    {
        "type": "image_picker",
        "id": "stars_image",
        "label": "Stars Image (Optional)",
        "info": "Upload if you don't want the default green boxes."
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Logo Label",
      "default": "Trustpilot"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Top Padding (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Bottom Padding (Mobile)",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2000,
      "max": 5000,
      "step": 500,
      "unit": "ms",
      "label": "Speed",
      "default": 4000
    },
    {
      "type": "header",
      "content": "Progress & Arrows"
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Progress Bar Color",
      "default": "#1A3C6E"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow Color",
      "default": "#1A3C6E"
    },
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Ebbe Peterson"
        },
        {
          "type": "image_picker",
          "id": "stars_image",
          "label": "Stars Image (Optional)",
          "info": "Upload if you don't want the default green boxes."
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Review Headline (Optional)",
          "default": "Solid byggekvalitet"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Review Content",
          "default": "<p>Solid byggekvalitet og hurtig levering. Disse låse er nu vores standard for alle containerforsendelser.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trustpilot Style Slider",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}