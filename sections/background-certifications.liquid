        </svg>
          <p class="cert-subheading">{{ section.settings.subheading }}</p>
        </div>
      {%- endif -%}
      <div class="cert-grid">
        {%- for block in section.blocks -%}
          <div class="cert-item" {{ block.shopify_attributes }}>
            <div class="cert-number">{{ block.settings.number }}</div>
            <div class="cert-text-content">
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Certifications Background",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "center right",
      "options": [
        { "value": "top left", "label": "Top Left" },
        { "value": "center center", "label": "Center" },
        { "value": "center right", "label": "Center Right" },
        { "value": "bottom center", "label": "Bottom Center" }
      ]
    },
     {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Image Position Mobile",
      "default": "center right",
      "options": [
        { "value": "top left", "label": "Top Left" },
        { "value": "center center", "label": "Center" },
        { "value": "center right", "label": "Center Right" },
        { "value": "bottom center", "label": "Bottom Center" }
      ]
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner Radius",
      "default": 16
    },
    {
      "type": "header",
      "content": "Overlay Settings"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Certificeret til maksimal sikkerhed"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 48
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading Label",
      "default": "Certifikater vi har"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "certification",
      "name": "Certification Point",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SSF 1051 – Security Class 5"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Testet og godkendt af SP Sverige. Det højeste niveau af forsikringsanerkendt containerlåsebeskyttelse."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Certifications Background",
      "blocks": [
        {
          "type": "certification",
          "settings": { "number": "01", "title": "SSF 1051 – Security Class 5" }
        },
        {
          "type": "certification",
          "settings": { "number": "02", "title": "EN 12320 – Grade 5 Padlocks" }
        },
        {
          "type": "certification",
          "settings": { "number": "03", "title": "SSF 014 – Class 4 Compliance" }
        },
        {
          "type": "certification",
          "settings": { "number": "04", "title": "VdS Certified (Germany)" }
        }
      ]
    }
  ]
}
{% endschema %}