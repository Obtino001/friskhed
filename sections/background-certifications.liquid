{% comment %}
  Industry Level "Background Image with Certifications" Section
  Replicates the dark blue sea container design with overlay grid.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

/* Main Container */
.cert-container {
position: relative;
border-radius: {{ section.settings.border_radius }}px;
overflow: hidden;
color: #ffffff;
min-height: 500px;
display: flex;
flex-direction: column;
justify-content: center;
}

/* Background Image Handling */
.cert-bg-image {
position: absolute;
top: 0;
left: 0;
width: 100%;
height: 100%;
z-index: 1;
}

.cert-bg-image img {
width: 100%;
height: 100%;
object-fit: cover;
object-position: {{ section.settings.image_position }};
}

/* Optional Overlay to ensure text readability */
.cert-overlay {
position: absolute;
top: 0;
left: 0;
width: 100%;
height: 100%;
background: {{ section.settings.overlay_color }};
opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
z-index: 2;
}

/* Content Wrapper */
.cert-content-wrapper {
position: relative;
z-index: 3;
padding: 60px 40px;
width: 100%;
max-width: 800px; /* Limits content width so it doesn't cover the ship on the right */
}

.cert-heading {
font-size: {{ section.settings.heading_size }}px;
font-family: Sora;
font-weight: 700;
leading-trim: NONE;
line-height: 120%;
max-width: 80%;
vertical-align: middle;

}

.cert-subheading-wrapper {
display: flex;
align-items: center;
gap: 10px;
margin-bottom: 40px;
}

.cert-subheading {
font-size: 18px;
font-weight: 500;
margin: 0;
color: #ffffff;
}

.cert-grid {
display: grid;
grid-template-columns: 1fr;
gap: 30px;
}

@media screen and (min-width: 750px) {
.cert-grid {
  grid-template-columns: 1fr 1fr; 
  column-gap: 60px;
  row-gap: 40px;
}
}

.cert-item {
display: flex;
align-items: flex-start;
gap: 15px;
}

.cert-number {
font-size: 40px;
font-weight: 700;
line-height: 1;
color: rgba(255, 255, 255, 0.3); /* Transparent styling */
flex-shrink: 0;
margin-top: -5px; /* Visual alignment fix */
}

.cert-text-content h4 {
margin: 0 0 15px 0;
font-size: 16px;
font-weight: 700;
color: #ffffff;
}

.cert-text-content p {
margin: 0;
font-size: 14px;
line-height: 1.5;
color: rgba(255, 255, 255, 0.8);
}

@media screen and (max-width: 749px) {
.cert-content-wrapper {
  padding: 40px 20px;
  max-width: 100%;
}
.cert-subheading{
font-size: 14px;

}
.cert-heading {
    font-size: 26px;
    max-width: 100%;
}
.cert-bg-image img {
width: 100%;
height: 100%;
object-fit: cover;
object-position: {{ section.settings.image_position_mobile }};
}
}
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="cert-container container-x">
    <div class="cert-bg-image">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2000 | image_tag: 
          loading: 'lazy',
          widths: '375, 550, 750, 1100, 1500, 2000',
          sizes: '100vw'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="cert-overlay"></div>
    <div class="cert-content-wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="cert-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
