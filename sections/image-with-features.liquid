{%- style -%}
  /* 1. APPLY FULL WIDTH BREAKOUT HERE */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Container */
  #shopify-section-{{ section.id }} .iwf-container {
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    height: 100%;
  }

  .iwf-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* DESKTOP SPLIT LAYOUT */
  @media screen and (min-width: 990px) {
    .iwf-wrapper {
      flex-direction: row;
      align-items: stretch; /* Ensures equal height */
      min-height: 600px;
    }

    .iwf-wrapper.image-right {
      flex-direction: row-reverse;
    }

    .iwf-column {
      width: 50%;
      min-height: 730px;
      position: relative;
    }
  }

  .iwf-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    max-height: 730px;
  }
  
  /* FLIP IMAGE RADIUS IF IMAGE IS ON RIGHT */
  @media screen and (min-width: 990px) {
     .iwf-wrapper.image-right .iwf-image {
        border-radius: 0; /* Reset */
        border-top-left-radius: 16px;
        border-bottom-left-radius: 16px;
     }
  }

  @media screen and (min-width: 990px) {
    .iwf-image-container {
       position: absolute;
       top: 0;
       left: 0;
       height: 100%;
       width: 100%;
    }
  }

  .iwf-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: transparent; 
  }

  .iwf-content-inner {
    padding: 40px 20px;
    background: #D9D9D933;

  }

  @media screen and (min-width: 990px) {
  
    .iwf-content-inner {
        background: #D9D9D933;
    }

    .iwf-wrapper:not(.image-right) .iwf-content {
       padding-right: max(40px, calc((100vw - 100%) / 2));
       padding-left: 0; /* No extra padding on inner side */
    }

    /* Inner Logic: Radius on right, extra padding on left (near image) */
    .iwf-wrapper:not(.image-right) .iwf-content-inner {
        padding: 40px 40px 40px 60px;
        border-top-right-radius: 15px;
        border-bottom-right-radius: 15px;
    }

    /* 2. IMAGE RIGHT LAYOUT (Image Right / Content Left) */
    /* Padding Logic: Push content away from left edge of screen */
    .iwf-wrapper.image-right .iwf-content {
       padding-left: max(40px, calc((100vw - 100%) / 2));
       padding-right: 0; /* No extra padding on inner side */
    }

    /* Inner Logic: Radius on left, extra padding on right (near image) */
    .iwf-wrapper.image-right .iwf-content-inner {
        padding: 20px 60px 20px 40px; /* Flipped Padding */
        border-top-left-radius: 15px;
        border-bottom-left-radius: 15px;
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }
  }
  /* --- DESKTOP LOGIC FIX ENDS HERE --- */

  .iwf-heading {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    margin-bottom: 30px;
    font-weight: 700;
    line-height: 1.2;
  }

  .iwf-features-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .iwf-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .iwf-icon-wrapper {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    background-color: {{ section.settings.icon_bg_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .iwf-icon-wrapper svg {
    width: 32px;
    height: 32px;
    color: {{ section.settings.icon_color }};
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  
  .iwf-icon-wrapper img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .iwf-text-content h3 {
    margin: 0 0 8px 0;
    font-size: 18px;
    color: {{ section.settings.heading_color }};
  }

  .iwf-text-content p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 990px) {
img.iwf-image {
    border-radius: 10px 10px 0 0;
}
    .iwf-text-content p {
        font-size: 12px;
    }

    .iwf-text-content h3 {
        font-size: 15px;
    }
.iwf-content-inner {
    padding: 30px;
    border-radius: 0 0 10px 10px;
}
    .iwf-heading {
        font-size: 26px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="iwf-container">
    <div class="iwf-wrapper {% if section.settings.layout == 'right' %}image-right{% endif %}">
      
      <div class="iwf-column">
        <div class="iwf-image-container">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1600 | image_tag: 
              loading: 'lazy', 
              sizes: '(min-width: 990px) 50vw, 100vw',
              widths: '375, 550, 750, 1100, 1500, 1800',
              class: 'iwf-image'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'iwf-image' }}
          {%- endif -%}
        </div>
      </div>

      <div class="iwf-column iwf-content">
        <div class="iwf-content-inner">
          {%- if section.settings.heading != blank -%}
            <h2 class="iwf-heading">{{ section.settings.heading }}</h2>
          {%- endif -%}

          <div class="iwf-features-list">
            {%- for block in section.blocks -%}
              <div class="iwf-feature-item" {{ block.shopify_attributes }}>
                
                <div class="iwf-icon-wrapper">
                  {%- if block.settings.custom_icon != blank -%}
                      {{ block.settings.custom_icon | image_url: width: 60 | image_tag }}
                  {%- else -%}
                    {% case block.settings.icon_select %}
                      {% when 'shield' %}
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                      {% when 'lock' %}
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                      {% when 'cloud' %}
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>
                      {% when 'settings' %}
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                      {% when 'check' %}
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {% endcase %}
                  {%- endif -%}
                </div>

                <div class="iwf-text-content">
                  <h3>{{ block.settings.title }}</h3>
                  <p>{{ block.settings.text }}</p>
                </div>

              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Features Full Width",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "left", "label": "Image Left" },
        { "value": "right", "label": "Image Right" }
      ],
      "default": "left",
      "label": "Desktop Image Position"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f4f4f4"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Hvorfor vælge os?",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading & Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Background",
      "default": "#E8F0FE"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#1A73E8"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "select",
          "id": "icon_select",
          "label": "Choose Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" },
            { "value": "cloud", "label": "Cloud" },
            { "value": "settings", "label": "Gear" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Forsikringsgodkendte låse",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "default": "Certificeret til at opfylde de højeste sikkerhedsstandarder.",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Features Full Width",
      "blocks": [
        { "type": "feature", "settings": { "icon_select": "shield", "title": "Forsikringsgodkendte låse" } },
        { "type": "feature", "settings": { "icon_select": "lock", "title": "Høj sikkerhed" } },
        { "type": "feature", "settings": { "icon_select": "cloud", "title": "Holdbar" } },
        { "type": "feature", "settings": { "icon_select": "settings", "title": "Nem installation" } }
      ]
    }
  ]
}
{% endschema %}