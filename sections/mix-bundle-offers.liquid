{%- style -%}
  .mix-offers-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .mix-offers-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign fallback_link = section.settings.collection_link | default: settings.cart_upsell_scents.url -%}

<div class="mix-offers mix-offers-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="mix-offers__header">
    {% if section.settings.heading != blank %}
      <h2 class="mix-offers__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="mix-offers__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="mix-offers__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign card_link = block.settings.button_link | default: fallback_link
        assign card_label = block.settings.button_label | default: 'Vælg scents'
      -%}
      {%- if card_link != blank -%}
        <a
          class="mix-offers__card{% if block.settings.featured %} is-featured{% endif %}"
          href="{{ card_link }}"
          {{ block.shopify_attributes }}
        >
      {%- else -%}
        <article class="mix-offers__card{% if block.settings.featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
      {%- endif -%}
        {% if block.settings.badge != blank %}
          <span class="mix-offers__badge">{{ block.settings.badge }}</span>
        {% endif %}
        <div class="mix-offers__lead">
          <div class="mix-offers__lead-copy">
            <h3 class="mix-offers__title">{{ block.settings.title }}</h3>
            {% if block.settings.compare_at != blank %}
              <p class="mix-offers__compare">{{ block.settings.compare_at }}</p>
            {% endif %}
          </div>
          {% if block.settings.price != blank %}
            <p class="mix-offers__price">{{ block.settings.price }}</p>
          {% endif %}
        </div>
        {% if block.settings.text != blank %}
          <p class="mix-offers__text">{{ block.settings.text }}</p>
        {% endif %}
        {% if card_label != blank %}
          <span class="button mix-offers__button{% if block.settings.featured %} mix-offers__button--on-dark{% endif %}">
            {{ card_label }}
          </span>
        {% endif %}
      {%- if card_link != blank -%}
        </a>
      {%- else -%}
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .mix-offers__header {
    margin-bottom: 16px;
    text-align: left;
  }

  .mix-offers__heading {
    margin: 0 0 6px;
    font-family: var(--font-heading--family, inherit);
    font-size: 1.5rem;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading, inherit);
  }

  .mix-offers__subheading {
    margin: 0;
    max-width: 36rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-foreground-muted, #555);
  }

  .mix-offers__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .mix-offers__card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 100%;
    padding: 16px;
    border-radius: 14px;
    background: #f5f5f7;
    color: inherit;
    text-decoration: none;
    border: 2px solid rgb(18 18 18 / 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  a.mix-offers__card {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  a.mix-offers__card:focus-visible {
    outline: 2px solid var(--color-foreground, #121212);
    outline-offset: 3px;
  }

  .mix-offers__card.is-featured {
    background: #121212;
    color: #fff;
    border-color: #121212;
    order: -1;
    padding: 18px 16px;
  }

  .mix-offers__badge {
    display: inline-flex;
    align-self: flex-start;
    margin-bottom: 10px;
    padding: 5px 10px;
    border-radius: 99px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: #13a877;
    color: #fff;
  }

  .mix-offers__lead {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .mix-offers__lead-copy {
    min-width: 0;
  }

  .mix-offers__title {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .mix-offers__price {
    margin: 0;
    flex: 0 0 auto;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-align: right;
  }

  .mix-offers__compare {
    margin: 4px 0 0;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #13a877;
  }

  .mix-offers__card.is-featured .mix-offers__compare {
    color: #7ddeb8;
  }

  .mix-offers__text {
    margin: 0 0 14px;
    font-size: 0.8125rem;
    line-height: 1.4;
    opacity: 0.75;
  }

  .mix-offers__button {
    margin-top: auto;
    width: 100%;
    min-height: 48px;
    justify-content: center;
    pointer-events: none;
    border-radius: 10px;
  }

  .mix-offers__button--on-dark {
    --button-color: #121212;
    --button-background-color: #fff;
    --button-border-color: #fff;
    color: #121212;
    background-color: #fff;
    box-shadow: none;
  }

  @media screen and (min-width: 750px) {
    .mix-offers__header {
      margin-bottom: 28px;
      text-align: center;
    }

    .mix-offers__heading {
      font-size: 2rem;
    }

    .mix-offers__subheading {
      margin: 0 auto;
      font-size: 0.9375rem;
    }

    .mix-offers__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      align-items: stretch;
    }

    .mix-offers__card {
      padding: 22px;
    }

    .mix-offers__card.is-featured {
      order: 0;
      padding: 22px;
    }

    .mix-offers__lead {
      flex-direction: column;
      gap: 8px;
      margin-bottom: 10px;
    }

    .mix-offers__price {
      text-align: left;
      font-size: 1.875rem;
    }

    a.mix-offers__card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgb(0 0 0 / 0.08);
      border-color: rgb(18 18 18 / 0.22);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mix bundle offers",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mix dine favoritter"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Saml dine scents og spar. Gratis fragt over 149 kr."
    },
    {
      "type": "url",
      "id": "collection_link",
      "label": "Default collection link",
      "info": "Used when a card has no own link. Typically aroma-kugler."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "title", "label": "Title", "default": "10 stk" },
        { "type": "text", "id": "price", "label": "Price", "default": "−5%" },
        { "type": "text", "id": "compare_at", "label": "Savings line", "default": "Mængderabat" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Køb 10 aroma-kugler og få 5% rabat" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Vælg scents" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "checkbox", "id": "featured", "label": "Featured (dark card)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mix bundle offers",
      "blocks": [
        {
          "type": "offer",
          "settings": {
            "badge": "Mest populær",
            "title": "10 stk",
            "price": "−5%",
            "compare_at": "Mængderabat",
            "text": "Køb 10 aroma-kugler og få 5% rabat. Rabatten trækkes automatisk i kurven.",
            "button_label": "Vælg 10 stk",
            "featured": true
          }
        },
        {
          "type": "offer",
          "settings": {
            "title": "15 stk",
            "price": "−10%",
            "compare_at": "Mængderabat",
            "text": "Køb 15 aroma-kugler og få 10% rabat.",
            "button_label": "Vælg 15 stk"
          }
        },
        {
          "type": "offer",
          "settings": {
            "badge": "Bedst værdi",
            "title": "30 stk",
            "price": "−15%",
            "compare_at": "Mængderabat",
            "text": "Køb 30 aroma-kugler og få 15% rabat.",
            "button_label": "Vælg 30 stk"
          }
        }
      ]
    }
  ]
}
{% endschema %}
