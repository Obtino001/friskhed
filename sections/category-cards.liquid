

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

.cc-header {
display: flex;
justify-content: space-between;
align-items: flex-end;
margin-bottom: 24px;
}

.cc-heading {
font-size: {{ section.settings.heading_size }}px;
font-weight: 700;
margin: 0;
line-height: 1.1;
color: {{ section.settings.heading_color }};
}

/* Grid */
.cc-grid {
display: grid;
grid-template-columns: 1fr;
gap: 20px;
}

@media screen and (min-width: 750px) {
.cc-grid {
  grid-template-columns: repeat(2, 1fr);
  gap: 30px;
}
}

/* Card Styles */
.cc-card {
background-color: #F5F5F7; /* Light grey */
border-radius: 16px;
overflow: hidden;
position: relative;
padding-inline: 40px;
min-height: 300px;
display: flex;
align-items: center;
justify-content: space-between;
transition: transform 0.3s ease;
}

.cc-content {
z-index: 2;
max-width: 55%;
}

.cc-card-title {
font-family: Sora;
font-weight: 700;
font-style: Bold;
font-size: 32px;
leading-trim: NONE;
line-height: 120%;
letter-spacing: -2%;
vertical-align: middle;

}
.cc-button {
display: inline-block;
padding: 12px 24px;
background-color: transparent;
border: 1px solid #000000;
color: #000000;
text-decoration: none;
font-family: Inter;
font-weight: 600;
font-style: Semi Bold;
font-size: 16px;
leading-trim: NONE;
line-height: 130%;
letter-spacing: 0%;
text-align: center;
vertical-align: middle;
border-radius: 6px;
transition: all 0.2s;
width: 100%;
text-align: center;
}
.cc-button:hover {
background-color: #000000;
color: #fff;
}

.cc-image-wrapper {
flex: 1;
display: flex;
justify-content: flex-end;
align-items: center;
}

.cc-image {
width: 100%;
max-width: 310px;
height: auto;
object-fit: contain;
mix-blend-mode: multiply; /* Helps blend whitespace if image has it */
}

@media screen and (max-width: 749px) {
  img.cc-image {
    max-width: 200px;
}
.cc-card { padding: 20px; flex-direction: column; align-items: flex-start; text-align: left; }
.cc-content { max-width: 100%; margin-bottom: 20px; }
.cc-image-wrapper { width: 100%; justify-content: center; }
.cc-card-title { font-size: 24px; }
}
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="">
    
    <div class="cc-header">
      <h2 class="cc-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_url != blank -%}
        <a href="{{ section.settings.link_url }}" class="cc-link">
          {{ section.settings.link_text }} 
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="cc-grid">
      {%- for block in section.blocks -%}
        <div class="cc-card" {{ block.shopify_attributes }}>
          <div class="cc-content">
            <h3 class="cc-card-title">{{ block.settings.title }}</h3>
            {%- if block.settings.btn_link != blank -%}
              <a href="{{ block.settings.btn_link }}" class="cc-button">{{ block.settings.btn_text }}</a>
            {%- endif -%}
          </div>
          <div class="cc-image-wrapper">
             {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'cc-image' }}
             {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'cc-image' }}
             {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Category Cards Grid",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop efter kategori" },
    { "type": "range", "id": "heading_size", "min": 24, "max": 64, "step": 2, "unit": "px", "label": "Heading Size", "default": 40 },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#000000" },
    { "type": "text", "id": "link_text", "label": "Link Text", "default": "Se alle" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top Padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom Padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Container Paints" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Browse Collection" },
        { "type": "url", "id": "btn_link", "label": "Button Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Cards Grid",
      "blocks": [
        { "type": "card", "settings": { "title": "Container Paints" } },
        { "type": "card", "settings": { "title": "Container Locks" } }
      ]
    }
  ]
}
{% endschema %}