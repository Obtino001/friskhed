{% liquid
  assign product = closest.product
-%}
{% if product.metafields.custom.product_selling_points.value != blank %}
<ul class="feature-list">
  {% for i in product.metafields.custom.product_selling_points.value %}
    <li>
      <svg class="checkmark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span>{{ i }}</span>
    </li>
  {% endfor %}
  </ul>
{% endif %}

  {% schema %}
{
    "name": "Selling points",
    "presets": [
    {
      "name": "Selling points"
    }
  ]
}
  {% endschema %}