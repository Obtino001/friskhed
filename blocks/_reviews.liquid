{%- assign block_settings = block.settings -%}
{%- assign trustpilot_url = settings.trustpilot_url | default: block.settings.url -%}

<div
  class="trustpilot-wrapper"
  style="
    padding-top: {{ block_settings.padding_top }}px;
    padding-bottom: {{ block_settings.padding_bottom }}px;
    padding-left: {{ block_settings.padding_left }}px;
    padding-right: {{ block_settings.padding_right }}px;
    text-align: {{ block_settings.alignment }};
    --color-text: {{ block_settings.icon_color }};
    --color-icon: {{ block_settings.icon_color }};
    --font-size: {{ block_settings.font_size }}px;
  "
  {{ block.shopify_attributes }}
>
  <a href="{{ trustpilot_url }}" {% if trustpilot_url != blank %}target="_blank" rel="noopener"{% endif %}>
    <div class="trustpilot-container">
      <div class="stars-row">
        {% if block_settings.image %}
          {{ block_settings.image | image_url: height: 18 | image_tag: alt: 'Trustpilot' }}
        {% endif %}
        <p class="trust-text">
          {% render 'trustpilot-claim' %}
        </p>
      </div>
    </div>
  </a>
</div>

<style>
  .trustpilot-wrapper {
    width: 100%;
  }
  .trustpilot-container {
    display: flex;
    padding-left: 1px;
    justify-content: {% if block_settings.alignment == 'center' %}center{% elsif block_settings.alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  .stars-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .stars-row img {
    height: {{ block.settings.star_size_desktop }}px;
    width: auto;
  }
  @media (max-width: 768px) {
    .stars-row img {
      height: {{ block.settings.star_size_mobile }}px;
    }
  }
  .stars-row p {
    margin: 0;
    font-size: var(--font-size);
    color: var(--color-text);
    line-height: 1;
  }
  .stars-row p strong {
    text-decoration: underline;
    font-weight: 400 !important;
  }
</style>

{% schema %}
{
  "name": "Trustpilot Icon",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "paragraph",
      "content": "Rating text always comes from Theme settings → Friskhed trust & identity (4,9 / 469)."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "star_size_desktop",
      "label": "Star Size (Desktop)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "star_size_mobile",
      "label": "Star Size (Mobile)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Legacy text (unused)",
      "default": "<p>4,9 på Trustpilot · 469 anmeldelser</p>",
      "info": "Unused. Live text always comes from Theme settings."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon & Text Color",
      "default": "#00b67a"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Fallback URL"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top Padding",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Left Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Right Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Trustpilot Icon"
    }
  ]
}
{% endschema %}
