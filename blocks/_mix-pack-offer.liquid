{%- liquid
  assign current_product = closest.product | default: product
  assign scent_collection = settings.cart_upsell_scents
  assign is_scent = false
  if scent_collection != blank and current_product != blank
    assign product_collection_ids = current_product.collections | map: 'id'
    if product_collection_ids contains scent_collection.id
      assign is_scent = true
    endif
  endif
-%}
{%- if settings.mix_pack_enable and is_scent -%}
  {%- liquid
    assign qty_10 = settings.mix_pack_10_qty | default: 10
    assign qty_15 = settings.mix_pack_15_qty | default: 15
    assign qty_30 = settings.mix_pack_30_qty | default: 30
    assign pct_10 = settings.mix_pack_10_pct | default: 5
    assign pct_15 = settings.mix_pack_15_pct | default: 10
    assign pct_30 = settings.mix_pack_30_pct | default: 15
    assign scent_url = scent_collection.url
    if scent_url != blank
      assign mix_url = scent_url | append: '?mix=10'
    endif
  -%}
  {%- if mix_url != blank -%}
    <a class="mix-pack-offer" href="{{ mix_url }}" {{ block.shopify_attributes }}>
      <p class="mix-pack-offer__text">
        Mix dine favoritter · {{ qty_10 }} stk −{{ pct_10 }}% · {{ qty_15 }} stk −{{ pct_15 }}% · {{ qty_30 }} stk −{{ pct_30 }}%
      </p>
      <span class="mix-pack-offer__link">Vælg {{ qty_10 }} stk</span>
    </a>
  {%- else -%}
    <div class="mix-pack-offer" {{ block.shopify_attributes }}>
      <p class="mix-pack-offer__text">
        Mix dine favoritter · {{ qty_10 }} stk −{{ pct_10 }}% · {{ qty_15 }} stk −{{ pct_15 }}% · {{ qty_30 }} stk −{{ pct_30 }}%
      </p>
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .mix-pack-offer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 12px;
    width: 100%;
    margin: 4px 0;
    padding: 10px 12px;
    border-radius: 8px;
    background: #f3faf7;
    color: inherit;
    text-decoration: none;
  }

  .mix-pack-offer__text {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .mix-pack-offer__link {
    font-size: 0.75rem;
    font-weight: 600;
    color: #13a877;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mix pack offer",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows 10 / 15 / 30 stk volume % from Theme settings. Create matching automatic discounts in Shopify admin."
    }
  ],
  "presets": [
    {
      "name": "Mix pack offer"
    }
  ]
}
{% endschema %}
