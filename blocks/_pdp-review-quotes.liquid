{%- liquid
  assign quote_count = 0
  for i in (1..3)
    assign quote_key = 'quote_' | append: i
    if block.settings[quote_key] != blank
      assign quote_count = quote_count | plus: 1
    endif
  endfor
-%}

{% if quote_count > 0 %}
  <pdp-review-carousel
    class="pdp-review-quotes"
    data-interval="2800"
    {{ block.shopify_attributes }}
  >
    <div class="pdp-review-quotes__viewport">
      <div class="pdp-review-quotes__track">
        {% for i in (1..3) %}
          {% liquid
            assign author_key = 'author_' | append: i
            assign quote_key = 'quote_' | append: i
            assign author = block.settings[author_key]
            assign quote = block.settings[quote_key]
          %}
          {% if quote != blank %}
            <blockquote class="pdp-review-quotes__item">
              <p class="pdp-review-quotes__text">“{{ quote | escape }}”</p>
              {% if author != blank %}
                <footer class="pdp-review-quotes__author">{{ author | escape }} · Trustpilot</footer>
              {% endif %}
            </blockquote>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </pdp-review-carousel>

  <script>
    if (!customElements.get('pdp-review-carousel')) {
      customElements.define(
        'pdp-review-carousel',
        class PdpReviewCarousel extends HTMLElement {
          connectedCallback() {
            this.track = this.querySelector('.pdp-review-quotes__track');
            this.slides = Array.from(this.querySelectorAll('.pdp-review-quotes__item'));
            this.index = 0;
            this.interval = Number(this.dataset.interval || 2800);
            if (this.slides.length < 2) return;

            const clone = this.slides[0].cloneNode(true);
            clone.setAttribute('aria-hidden', 'true');
            this.track.appendChild(clone);

            this.track.addEventListener('transitionend', () => {
              if (this.index !== this.slides.length) return;
              this.track.style.transition = 'none';
              this.index = 0;
              this.track.style.transform = 'translateX(0)';
              void this.track.offsetWidth;
              this.track.style.transition = '';
            });

            this.start();
            this.addEventListener('pointerenter', () => this.stop());
            this.addEventListener('pointerleave', () => this.start());
          }

          disconnectedCallback() {
            this.stop();
          }

          start() {
            this.stop();
            this.timer = setInterval(() => this.go(this.index + 1), this.interval);
          }

          stop() {
            if (this.timer) clearInterval(this.timer);
          }

          go(next) {
            this.index = next;
            this.track.style.transform = 'translateX(-' + this.index * 100 + '%)';
          }
        }
      );
    }
  </script>
{% endif %}

{% stylesheet %}
  .pdp-review-quotes {
    display: block;
    width: 100%;
    margin: 0;
  }

  .pdp-review-quotes__viewport {
    overflow: hidden;
    border-radius: 8px;
  }

  .pdp-review-quotes__track {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .pdp-review-quotes__track {
      transition: none;
    }
  }

  .pdp-review-quotes__item {
    flex: 0 0 100%;
    margin: 0;
    padding: 12px 14px;
    background: rgba(0, 0, 0, 0.04);
    box-sizing: border-box;
  }

  .pdp-review-quotes__text {
    margin: 0 0 4px;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .pdp-review-quotes__author {
    font-size: 0.75rem;
    color: var(--color-foreground-muted, #666);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP review quotes",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "author_1",
      "label": "Author 1",
      "default": "Jan"
    },
    {
      "type": "text",
      "id": "quote_1",
      "label": "Quote 1",
      "default": "Som sædvanlig hurtig levering, kan kun anbefale Friskhed"
    },
    {
      "type": "text",
      "id": "author_2",
      "label": "Author 2",
      "default": "Inge Nielsen"
    },
    {
      "type": "text",
      "id": "quote_2",
      "label": "Quote 2",
      "default": "Fantastisk produkt. Endnu mere fantastisk service og lynhurtig levering"
    },
    {
      "type": "text",
      "id": "author_3",
      "label": "Author 3",
      "default": "Camilla"
    },
    {
      "type": "text",
      "id": "quote_3",
      "label": "Quote 3",
      "default": "Altid hurtig modtagelse af vare. Og super kundeservice"
    }
  ],
  "presets": [
    {
      "name": "PDP review quotes"
    }
  ]
}
{% endschema %}
