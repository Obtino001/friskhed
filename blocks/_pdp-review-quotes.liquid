{%- liquid
  assign quote_count = 0
  for i in (1..3)
    assign quote_key = 'quote_' | append: i
    if block.settings[quote_key] != blank
      assign quote_count = quote_count | plus: 1
    endif
  endfor
-%}

{% if quote_count > 0 %}
  <pdp-review-carousel
    class="pdp-review-quotes"
    data-interval="4500"
    {{ block.shopify_attributes }}
  >
    <div class="pdp-review-quotes__viewport">
      {% assign shown = 0 %}
      {% for i in (1..3) %}
        {% liquid
          assign author_key = 'author_' | append: i
          assign quote_key = 'quote_' | append: i
          assign author = block.settings[author_key]
          assign quote = block.settings[quote_key]
        %}
        {% if quote != blank %}
          {% assign shown = shown | plus: 1 %}
          <blockquote class="pdp-review-quotes__item"{% unless shown == 1 %} hidden{% endunless %}>
            <p class="pdp-review-quotes__text">“{{ quote | escape }}”</p>
            {% if author != blank %}
              <footer class="pdp-review-quotes__author">{{ author | escape }} · Trustpilot</footer>
            {% endif %}
          </blockquote>
        {% endif %}
      {% endfor %}
    </div>

    {% if quote_count > 1 %}
      <div class="pdp-review-quotes__nav" aria-label="Trustpilot anmeldelser">
        {% assign shown = 0 %}
        {% for i in (1..3) %}
          {% assign quote_key = 'quote_' | append: i %}
          {% if block.settings[quote_key] != blank %}
            {% assign shown = shown | plus: 1 %}
            <button
              type="button"
              class="pdp-review-quotes__dot{% if shown == 1 %} is-active{% endif %}"
              data-dot
              aria-label="Anmeldelse {{ shown }}"
            ></button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </pdp-review-carousel>

  <script>
    if (!customElements.get('pdp-review-carousel')) {
      customElements.define(
        'pdp-review-carousel',
        class PdpReviewCarousel extends HTMLElement {
          connectedCallback() {
            this.slides = Array.from(this.querySelectorAll('.pdp-review-quotes__item'));
            this.dots = Array.from(this.querySelectorAll('[data-dot]'));
            this.index = 0;
            this.interval = Number(this.dataset.interval || 4500);
            this.dots.forEach((dot, i) => {
              dot.addEventListener('click', () => this.go(i, true));
            });
            this.start();
            this.addEventListener('pointerenter', () => this.stop());
            this.addEventListener('pointerleave', () => this.start());
          }

          disconnectedCallback() {
            this.stop();
          }

          start() {
            this.stop();
            if (this.slides.length < 2) return;
            this.timer = setInterval(() => this.go(this.index + 1), this.interval);
          }

          stop() {
            if (this.timer) clearInterval(this.timer);
          }

          go(next, user) {
            if (!this.slides.length) return;
            this.index = ((next % this.slides.length) + this.slides.length) % this.slides.length;
            this.slides.forEach((slide, i) => {
              slide.hidden = i !== this.index;
            });
            this.dots.forEach((dot, i) => {
              dot.classList.toggle('is-active', i === this.index);
            });
            if (user) this.start();
          }
        }
      );
    }
  </script>
{% endif %}

{% stylesheet %}
  .pdp-review-quotes {
    display: block;
    width: 100%;
    margin: 0;
  }

  .pdp-review-quotes__viewport {
    min-height: 0;
  }

  .pdp-review-quotes__item {
    margin: 0;
    padding: 8px 10px;
    background: rgba(0, 0, 0, 0.04);
    border-radius: 8px;
  }

  .pdp-review-quotes__text {
    margin: 0 0 2px;
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .pdp-review-quotes__author {
    font-size: 0.6875rem;
    color: var(--color-foreground-muted, #666);
  }

  .pdp-review-quotes__nav {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 6px;
  }

  .pdp-review-quotes__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.2);
    cursor: pointer;
  }

  .pdp-review-quotes__dot.is-active {
    background: #13a877;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP review quotes",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "author_1",
      "label": "Author 1",
      "default": "Jan"
    },
    {
      "type": "text",
      "id": "quote_1",
      "label": "Quote 1",
      "default": "Som sædvanlig hurtig levering, kan kun anbefale Friskhed"
    },
    {
      "type": "text",
      "id": "author_2",
      "label": "Author 2",
      "default": "Inge Nielsen"
    },
    {
      "type": "text",
      "id": "quote_2",
      "label": "Quote 2",
      "default": "Fantastisk produkt. Endnu mere fantastisk service og lynhurtig levering"
    },
    {
      "type": "text",
      "id": "author_3",
      "label": "Author 3",
      "default": "Camilla"
    },
    {
      "type": "text",
      "id": "quote_3",
      "label": "Quote 3",
      "default": "Altid hurtig modtagelse af vare. Og super kundeservice"
    }
  ],
  "presets": [
    {
      "name": "PDP review quotes"
    }
  ]
}
{% endschema %}
