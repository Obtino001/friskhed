{% comment %}
  Section: Promo Alert
  Description: A dismissible promotional alert box.
{% endcomment %}

<div class="upa-section-wrapper">
  
  <div class="upa-alert-box" id="upa-alert-{{ section.id }}">
    
    <div class="upa-icon-wrapper">
      <svg class="upa-svg upa-svg-bolt" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path d="M12.5 1.25L11.25 7.5L16.25 9.375L7.5 18.75L8.75 12.5L3.75 10.625L12.5 1.25Z" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>

    <div class="upa-content">
      {% if block.settings.heading != blank %}
        <div class="upa-title">{{ block.settings.heading }}</div>
      {% endif %}
      
      <div class="upa-message">
        <p>
          {{ block.settings.text }}
          {% if block.settings.link_url != blank and block.settings.link_text != blank %}
            <a href="{{ block.settings.link_url }}" title="{{ block.settings.link_text }}">
              {{ block.settings.link_text }}
            </a>
          {% endif %}
        </p>
      </div>
    </div>

    <button class="upa-close-btn" aria-label="Close" type="button" onclick="closeUpaAlert('{{ section.id }}')">
      <svg class="upa-svg upa-svg-close" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M18.75 5.13496L5.25 18.8544" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M18.75 18.8544L5.25 5.13496" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

</div>

{% style %}
  /* Unique Class Prefix: upa- (Unique Promo Alert) */

  .upa-section-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .upa-alert-box {
    box-sizing: border-box;
    position: relative;
    display: flex;
    align-items: flex-start;
    
    /* Dynamic Colors from Schema */
    background-color: {{ block.settings.bg_color }};
    color: {{ block.settings.text_color }};
    
    padding: 16px;
    border-radius: 12px;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    gap: 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    transition: opacity 0.3s ease, transform 0.3s ease, max-height 0.3s ease;
    
    /* Ensure no theme styles override these */
    line-height: normal;
    text-align: left;
    margin: 0;
  }

  .upa-alert-box * {
    box-sizing: border-box;
  }

  /* Icon Wrapper */
  .upa-icon-wrapper {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 2px; /* Optical alignment with text cap-height */
  }

  .upa-svg {
    display: block;
    fill: none;
    stroke: currentColor;
  }

  .upa-svg-bolt {
    width: 24px;
    height: 24px;
    stroke-width: 1.5px;
  }

  /* Content */
  .upa-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
    padding-right: 24px; /* Space for close button */
  }

  .upa-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: inherit;
  }

  .upa-message {
    font-size: 14px;
    line-height: 1.4;
    font-weight: 400;
    color: inherit;
  }
  
  .upa-message p {
    margin: 0;
    padding: 0;
    color: inherit;
  }

  .upa-message a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 400;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .upa-message a:hover {
    opacity: 0.8;
  }

  /* Close Button */
  .upa-close-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
    padding: 4px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
    appearance: none;
    box-shadow: none;
  }

  .upa-close-btn:hover {
    background-color: rgba(0, 0, 0, 0.06);
  }

  .upa-svg-close {
    width: 20px;
    height: 20px;
    stroke-width: 1.5px;
  }
{% endstyle %}

<script>
  function closeUpaAlert(id) {
    var element = document.getElementById('upa-alert-' + id);
    if (element) {
      element.style.opacity = '0';
      element.style.transform = 'translateY(-10px)';
      // Wait for transition to finish before removing from flow
      setTimeout(function() {
        element.style.display = 'none';
      }, 300);
    }
  }
</script>

{% schema %}
{
  "name": "Promo Alert Box",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Limited time offer"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Message",
      "default": "Get $20 off when you spend $1,000 or more!"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#EAF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Icon Color",
      "default": "#007A5C"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Max Width",
      "default": 600
    },
  ],
  "presets": [
    {
      "name": "Promo Alert Box"
    }
  ]
}
{% endschema %}