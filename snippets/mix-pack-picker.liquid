{%- if settings.mix_pack_enable -%}
  {%- liquid
    assign app = settings.cart_upsell_applicator
    assign app_alt = settings.cart_upsell_applicator_alt
    assign app_variant = app.selected_or_first_available_variant
    assign app_alt_variant = app_alt.selected_or_first_available_variant
    assign qty_3 = settings.mix_pack_3_qty | default: 3
    assign qty_5 = settings.mix_pack_5_qty | default: 5
    assign price_3 = settings.mix_pack_3_price | default: '49'
    assign price_5 = settings.mix_pack_5_price | default: '75'
  -%}

  <script>
    (function () {
      if (!new URLSearchParams(location.search).get('mix')) return;
      document.documentElement.dataset.mixPicker = 'on';
      document.addEventListener(
        'click',
        function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest('mix-pack-picker, [data-mix-top]')) return;
          if (target.closest('a.product-card__link, product-card-link, product-card, .product-grid__item[data-variant-id]')) {
            event.preventDefault();
          }
        },
        true
      );
    })();
  </script>
  <script src="{{ 'mix-pack-picker.js' | asset_url }}" type="module"></script>

  <mix-pack-picker
    class="mix-pick"
    hidden
    data-qty-3="{{ qty_3 }}"
    data-qty-5="{{ qty_5 }}"
    data-price-3="{{ price_3 }}"
    data-price-5="{{ price_5 }}"
    data-save-3="11"
    data-save-5="25"
    data-app-id="{{ app_variant.id }}"
    data-collection="{{ collection.handle }}"
    data-scent-collection="{{ settings.cart_upsell_scents.handle }}"
  >
    <div class="mix-pick__top" data-mix-top>
      <div class="mix-pick__top-inner">
        <div class="mix-pick__top-head">
          <p class="mix-pick__top-kicker">Mix dine favoritter</p>
          <p class="mix-pick__top-hint">Tryk på scents for at fylde dit mix</p>
        </div>
        <div class="mix-pick__top-offers">
          <button type="button" class="mix-pick__offer is-active" data-mix-offer="3">
            <span class="mix-pick__offer-name">Mix 3</span>
            <span class="mix-pick__offer-price">{{ price_3 }} kr</span>
            <span class="mix-pick__offer-save">Spar 11 kr</span>
          </button>
          <button type="button" class="mix-pick__offer" data-mix-offer="5">
            <span class="mix-pick__offer-name">Mix 5</span>
            <span class="mix-pick__offer-price">{{ price_5 }} kr</span>
            <span class="mix-pick__offer-save">Spar 25 kr</span>
          </button>
        </div>
        <div class="mix-pick__progress">
          <div class="mix-pick__slots" data-mix-slots aria-hidden="true"></div>
          <p class="mix-pick__top-status">
            <strong><span data-mix-count>0</span>/<span data-mix-target-label>{{ qty_3 }}</span></strong>
            <span data-mix-status>Vælg dine scents</span>
          </p>
        </div>
      </div>
    </div>

    <div class="mix-pick__bar">
      {% if app != blank or app_alt != blank %}
        <div class="mix-pick__apps">
          <label class="mix-pick__check">
            <input type="checkbox" data-mix-app>
            <span>Med applikator</span>
          </label>
          <div class="mix-pick__segment mix-pick__segment--apps" data-mix-app-types hidden>
            {% if app != blank and app_variant.available %}
              <label class="mix-pick__seg">
                <input type="radio" name="mix-app-type" data-mix-app-type value="{{ app_variant.id }}" checked>
                <span>Classic</span>
              </label>
            {% endif %}
            {% if app_alt != blank and app_alt_variant.available %}
              <label class="mix-pick__seg">
                <input
                  type="radio"
                  name="mix-app-type"
                  data-mix-app-type
                  value="{{ app_alt_variant.id }}"
                  {% if app == blank %}checked{% endif %}
                >
                <span>Color</span>
              </label>
            {% endif %}
          </div>
        </div>
      {% endif %}
      <button type="button" class="button mix-pick__submit" data-mix-submit disabled>
        Vælg {{ qty_3 }} scents
      </button>
    </div>
  </mix-pack-picker>
{%- endif -%}

{% stylesheet %}
  mix-pack-picker.mix-pick {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 80;
    display: block;
    width: 100%;
    background: #fff;
    border-top: 1px solid rgb(18 18 18 / 0.08);
    box-shadow: 0 -8px 28px rgb(18 18 18 / 0.08);
  }

  mix-pack-picker.mix-pick[hidden] {
    display: none !important;
  }

  .mix-pick__top {
    width: 100%;
    margin: 0 0 12px;
    padding: 14px;
    border-radius: 16px;
    background: #f6f6f6;
    color: #121212;
    border: 1px solid rgb(18 18 18 / 0.08);
  }

  .mix-pick__top-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mix-pick__top-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mix-pick__top-kicker {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .mix-pick__top-hint {
    margin: 0;
    font-size: 0.75rem;
    color: #666;
  }

  .mix-pick__top-offers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .mix-pick__offer {
    appearance: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 12px;
    border-radius: 12px;
    border: 1.5px solid rgb(18 18 18 / 0.12);
    background: #fff;
    color: #121212;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .mix-pick__offer-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: #666;
  }

  .mix-pick__offer-price {
    font-size: 1.125rem;
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .mix-pick__offer-save {
    font-size: 0.75rem;
    font-weight: 650;
    color: #0f7a52;
  }

  .mix-pick__offer.is-active {
    background: #121212;
    color: #fff;
    border-color: #121212;
  }

  .mix-pick__offer.is-active .mix-pick__offer-name {
    color: rgb(255 255 255 / 0.7);
  }

  .mix-pick__offer.is-active .mix-pick__offer-save {
    color: #8ee7c0;
  }

  .mix-pick__offer.is-ready {
    box-shadow: inset 0 0 0 2px #13a877;
  }

  .mix-pick__progress {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mix-pick__slots {
    display: flex;
    gap: 6px;
    width: 100%;
  }

  .mix-pick__slot {
    flex: 1;
    height: 6px;
    border-radius: 99px;
    background: #e4e4e4;
  }

  .mix-pick__slot.is-filled {
    background: #13a877;
  }

  .mix-pick__top-status {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: #444;
  }

  .mix-pick__top-status strong {
    font-variant-numeric: tabular-nums;
    color: #121212;
  }

  .mix-pick__top.is-ready .mix-pick__top-status {
    color: #0f7a52;
  }

  html[data-mix-picker='on'] p.collection-tittle-custom {
    padding-top: 20px;
    padding-bottom: 10px;
  }

  .mix-pick__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
  }

  .mix-pick__apps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .mix-pick__segment {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: #f3f3f3;
  }

  .mix-pick__seg,
  .mix-pick__check {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
  }

  .mix-pick__seg input,
  .mix-pick__check input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .mix-pick__seg:has(input:checked) {
    background: #121212;
    color: #fff;
  }

  .mix-pick__check {
    border: 1px solid rgb(18 18 18 / 0.16);
    background: #fff;
  }

  .mix-pick__check:has(input:checked) {
    background: #121212;
    color: #fff;
    border-color: #121212;
  }

  .mix-pick__submit {
    flex: 1 1 180px;
    min-height: 48px;
    margin: 0;
  }

  html[data-mix-picker='on'] a.product-card__link {
    pointer-events: none;
  }

  body[data-mix-picker='on'] {
    padding-bottom: 88px;
  }

  body[data-mix-picker='on'] .product-grid__item,
  body[data-mix-picker='on'] product-card {
    cursor: pointer;
  }

  body[data-mix-picker='on'] .product-grid__item.is-mix-selected .product-card,
  body[data-mix-picker='on'] .product-grid__item.is-mix-selected .card-gallery {
    position: relative;
  }

  body[data-mix-picker='on'] .product-grid__item.is-mix-selected .product-card {
    outline: 2px solid #121212;
    outline-offset: -2px;
  }

  .mix-pick-mark {
    position: absolute;
    top: auto;
    bottom: 10px;
    left: 10px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #13a877;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 750;
    line-height: 1;
    pointer-events: none;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.18);
  }

  body[data-mix-picker='on'] .product-grid__item.is-mix-locked {
    opacity: 0.45;
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .mix-pick__top {
      padding: 16px 18px;
    }

    .mix-pick__bar {
      flex-wrap: nowrap;
      padding: 12px 24px calc(12px + env(safe-area-inset-bottom));
    }

    .mix-pick__submit {
      flex: 0 0 auto;
      min-width: 220px;
    }

    body[data-mix-picker='on'] {
      padding-bottom: 80px;
    }
  }
{% endstylesheet %}
