{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'CartUpsell-ProductForm-' | append: product.id | append: '-' | append: section.id
  assign button_id = 'CartUpsell-Submit-' | append: product.id
  assign add_label = 'actions.add' | t
-%}

<div class="cart-upsell__row">
  {% if product.featured_image %}
    {{ product.featured_image | image_url: width: 96 | image_tag: alt: product.title, loading: 'lazy', class: 'cart-upsell__image' }}
  {% endif %}
  <div class="cart-upsell__meta">
    <span class="cart-upsell__title">{{ product.title }}</span>
    <span class="cart-upsell__price">{{ variant.price | money }}</span>
  </div>

  {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form', class: 'cart-upsell__form', data-product-id: product.id -%}
    <input type="hidden" name="id" value="{{ variant.id }}">
    <input type="hidden" name="quantity" value="1">
    {% render 'add-to-cart-button',
      id: button_id,
      class: 'button add-to-cart-button',
      can_add_to_cart: variant.available,
      product: product,
      add_to_cart_text: add_label
    %}
  {%- endform -%}
</div>
