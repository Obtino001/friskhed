{%- liquid
  assign applicator = settings.cart_upsell_applicator
  assign scent_collection = settings.cart_upsell_scents
  assign cart_product_ids = cart.items | map: 'product_id'
  assign show_applicator = false
  assign upsell_product = nil

  if applicator != blank
    unless cart_product_ids contains applicator.id
      if applicator.available
        assign show_applicator = true
      endif
    endunless
  endif

  if scent_collection != blank
    for rec in scent_collection.products limit: 12
      unless cart_product_ids contains rec.id
        if rec.available
          assign upsell_product = rec
          break
        endif
      endunless
    endfor
  endif
-%}

{% if show_applicator or upsell_product %}
  <div class="cart-upsell">
    <p class="cart-upsell__heading">Gør ordren komplet</p>

    {% if show_applicator %}
      {% render 'cart-upsell-item', product: applicator, section: section %}
    {% endif %}

    {% if upsell_product %}
      {% render 'cart-upsell-item', product: upsell_product, section: section %}
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .cart-upsell {
    padding: 12px 24px 16px;
    border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }

  .cart-upsell__heading {
    margin: 0 0 12px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .cart-upsell__row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
  }

  .cart-upsell__row img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: var(--style-border-radius-inputs, 6px);
  }

  .cart-upsell__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .cart-upsell__title {
    font-size: 0.8125rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-upsell__price {
    font-size: 0.75rem;
  }

  .cart-upsell__form,
  .cart-upsell__form .product-form-buttons,
  .cart-upsell__form product-form-component {
    display: contents;
  }

  .cart-upsell .add-to-cart-button {
    min-height: var(--height-buy-buttons, 44px);
    padding-inline: 16px;
    white-space: nowrap;
  }
{% endstylesheet %}
