{%- liquid
  assign applicator = settings.cart_upsell_applicator
  assign applicator_alt = settings.cart_upsell_applicator_alt
  assign scent_collection = settings.cart_upsell_scents
  assign cart_product_ids = cart.items | map: 'product_id'
  assign skip_product_id = exclude_product.id
  assign show_applicator = false
  assign show_applicator_alt = false
  assign viewing_applicator = false
  assign applicator_in_cart = false
  assign upsell_product = nil
  assign qty_10 = settings.mix_pack_10_qty | default: 10
  assign qty_15 = settings.mix_pack_15_qty | default: 15
  assign qty_30 = settings.mix_pack_30_qty | default: 30
  assign pct_10 = settings.mix_pack_10_pct | default: 10
  assign pct_15 = settings.mix_pack_15_pct | default: 15
  assign pct_30 = settings.mix_pack_30_pct | default: 20
  assign upsell_heading = 'Gør ordren komplet'
-%}
{%- capture applicator_ids -%}{% render 'applicator-ids' %}{%- endcapture -%}
{%- capture mix_pack_qty -%}{% render 'mix-pack-count' %}{%- endcapture -%}
{%- liquid
  assign mix_pack_qty = mix_pack_qty | plus: 0
  assign skip_token = ':' | append: skip_product_id | append: ':'
  if skip_product_id != blank and applicator_ids contains skip_token
    assign viewing_applicator = true
  endif
  if applicator != blank and cart_product_ids contains applicator.id
    assign applicator_in_cart = true
  endif
  if applicator_alt != blank and cart_product_ids contains applicator_alt.id
    assign applicator_in_cart = true
  endif

  if settings.mix_pack_enable and mix_pack_qty > 0 and mix_pack_qty < qty_10
    assign need_10 = qty_10 | minus: mix_pack_qty
    assign upsell_heading = 'Tilføj ' | append: need_10 | append: ' mere og få ' | append: pct_10 | append: '% rabat'
  elsif settings.mix_pack_enable and mix_pack_qty >= qty_10 and mix_pack_qty < qty_15
    assign upsell_heading = pct_10 | append: '% aktiv · gå efter ' | append: pct_15 | append: '%'
  elsif settings.mix_pack_enable and mix_pack_qty >= qty_15 and mix_pack_qty < qty_30
    assign upsell_heading = pct_15 | append: '% aktiv · gå efter ' | append: pct_30 | append: '%'
  endif

  unless viewing_applicator or applicator_in_cart
    if applicator != blank and applicator.available
      unless skip_product_id != blank and applicator.id == skip_product_id
        assign show_applicator = true
      endunless
    endif
    if applicator_alt != blank and applicator_alt.available
      unless skip_product_id != blank and applicator_alt.id == skip_product_id
        assign show_applicator_alt = true
      endunless
    endif
    if show_applicator or show_applicator_alt
      assign upsell_heading = 'Vælg en applikator'
    endif
  endunless

  if scent_collection != blank
    for rec in scent_collection.products limit: 12
      unless cart_product_ids contains rec.id
        unless skip_product_id != blank and rec.id == skip_product_id
          if rec.available
            assign upsell_product = rec
            break
          endif
        endunless
      endunless
    endfor
  endif
-%}

<script src="{{ 'cart-upsell.js' | asset_url }}" type="module"></script>

{% if show_applicator or show_applicator_alt or upsell_product %}
  <cart-upsell class="cart-upsell{% if context == 'pdp' %} cart-upsell--pdp{% endif %}">
    <p class="cart-upsell__heading">{{ upsell_heading }}</p>

    {% if show_applicator %}
      {% render 'cart-upsell-item', product: applicator, section: section %}
    {% endif %}

    {% if show_applicator_alt %}
      {% render 'cart-upsell-item', product: applicator_alt, section: section %}
    {% endif %}

    {% if upsell_product %}
      {% if show_applicator or show_applicator_alt %}
        <p class="cart-upsell__heading cart-upsell__heading--sub">Gør ordren komplet</p>
      {% endif %}
      {% render 'cart-upsell-item', product: upsell_product, section: section %}
    {% endif %}
  </cart-upsell>
{% endif %}

{% stylesheet %}
  .cart-drawer__items .cart-items__wrapper {
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items {
    padding-bottom: 0;
  }

  .cart-upsell {
    display: block;
    padding: 16px 0 12px;
    border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
    overflow: visible;
  }

  .cart-upsell__heading {
    margin: 0 0 8px;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .cart-upsell__heading--sub {
    margin-top: 12px;
  }

  .cart-upsell__row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    margin-bottom: 8px;
  }

  .cart-upsell__row:last-child {
    margin-bottom: 0;
  }

  .cart-upsell__image {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: var(--style-border-radius-inputs, 6px);
    display: block;
  }

  .cart-upsell__meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-width: 0;
  }

  .cart-upsell__title {
    font-size: 0.8125rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-upsell__price {
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .cart-upsell__form {
    margin: 0;
    display: flex;
    align-items: center;
  }

  .cart-upsell .add-to-cart-button {
    position: relative;
    overflow: hidden;
    min-height: 40px;
    height: 40px;
    padding-inline: 14px;
    white-space: nowrap;
  }

  .cart-upsell .add-to-cart__added-icon {
    width: 24px;
    height: 24px;
  }

  .cart-upsell--pdp {
    width: 100%;
    padding: 12px 0 4px;
    border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }
{% endstylesheet %}
