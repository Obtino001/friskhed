{%- liquid
  assign applicator = settings.cart_upsell_applicator
  assign scent_collection = settings.cart_upsell_scents
  assign cart_product_ids = cart.items | map: 'product_id'
  assign skip_product_id = exclude_product.id
  assign show_applicator = false
  assign upsell_product = nil
  assign qty_3 = settings.mix_pack_3_qty | default: 3
  assign qty_5 = settings.mix_pack_5_qty | default: 5
  assign price_3 = settings.mix_pack_3_price | default: '49' | times: 100
  assign price_5 = settings.mix_pack_5_price | default: '75' | times: 100
  assign upsell_heading = 'Gør ordren komplet'
-%}
{%- capture mix_pack_qty -%}{% render 'mix-pack-count' %}{%- endcapture -%}
{%- liquid
  assign mix_pack_qty = mix_pack_qty | plus: 0
  assign price_3_label = price_3 | money_without_trailing_zeros
  assign price_5_label = price_5 | money_without_trailing_zeros
  if settings.mix_pack_enable and mix_pack_qty > 0 and mix_pack_qty < qty_3
    assign upsell_heading = 'Mix ' | append: qty_3 | append: ' stk for ' | append: price_3_label
  elsif settings.mix_pack_enable and mix_pack_qty >= qty_3 and mix_pack_qty < qty_5
    assign upsell_heading = 'Mix ' | append: qty_5 | append: ' stk for ' | append: price_5_label
  endif

  if applicator != blank
    unless cart_product_ids contains applicator.id
      unless skip_product_id != blank and applicator.id == skip_product_id
        if applicator.available
          assign show_applicator = true
        endif
      endunless
    endunless
  endif

  if scent_collection != blank
    for rec in scent_collection.products limit: 12
      unless cart_product_ids contains rec.id
        unless skip_product_id != blank and rec.id == skip_product_id
          if rec.available
            assign upsell_product = rec
            break
          endif
        endunless
      endunless
    endfor
  endif
-%}

<script src="{{ 'cart-upsell.js' | asset_url }}" type="module"></script>

{% if show_applicator or upsell_product %}
  <cart-upsell class="cart-upsell{% if context == 'pdp' %} cart-upsell--pdp{% endif %}">
    <p class="cart-upsell__heading">{{ upsell_heading }}</p>

    {% if show_applicator %}
      {% render 'cart-upsell-item', product: applicator, section: section %}
    {% endif %}

    {% if upsell_product %}
      {% render 'cart-upsell-item', product: upsell_product, section: section %}
    {% endif %}
  </cart-upsell>
{% endif %}

{% stylesheet %}
  .cart-drawer__items .cart-items__wrapper {
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items {
    padding-bottom: 0;
  }

  .cart-upsell {
    display: block;
    padding: 16px 0 12px;
    border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
    overflow: visible;
  }

  .cart-upsell__heading {
    margin: 0 0 8px;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .cart-upsell__row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    margin-bottom: 8px;
  }

  .cart-upsell__row:last-child {
    margin-bottom: 0;
  }

  .cart-upsell__image {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: var(--style-border-radius-inputs, 6px);
    display: block;
  }

  .cart-upsell__meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-width: 0;
  }

  .cart-upsell__title {
    font-size: 0.8125rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-upsell__price {
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .cart-upsell__form {
    margin: 0;
    display: flex;
    align-items: center;
  }

  .cart-upsell .add-to-cart-button {
    position: relative;
    overflow: hidden;
    min-height: 40px;
    height: 40px;
    padding-inline: 14px;
    white-space: nowrap;
  }

  .cart-upsell .add-to-cart__added-icon {
    width: 24px;
    height: 24px;
  }

  .cart-upsell--pdp {
    width: 100%;
    padding: 12px 0 4px;
    border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }
{% endstylesheet %}
