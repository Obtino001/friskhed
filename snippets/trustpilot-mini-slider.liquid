{%- doc -%}
  Compact Trustpilot review slider. Uses the single canonical rating from theme settings
  so the number always matches the trust bar, hero and PDP.
{%- enddoc -%}

{%- liquid
  assign rating = settings.trustpilot_rating | default: '4,9'
  assign count = settings.trustpilot_review_count | default: '469'
  assign tp_url = settings.trustpilot_url | default: 'https://dk.trustpilot.com/review/friskhed.dk'
-%}

{%- capture stars -%}
  <span class="tp-mini__stars" aria-hidden="true">
    {%- for star in (1..5) -%}
      <span class="tp-mini__star">
        <svg viewBox="0 0 16 16" width="11" height="11" fill="#fff">
          <path d="M8 2.1l1.8 3.7 4.1.6-3 2.9.7 4.1L8 11.5l-3.6 1.9.7-4.1-3-2.9 4.1-.6L8 2.1Z"/>
        </svg>
      </span>
    {%- endfor -%}
  </span>
{%- endcapture -%}

<div class="tp-mini">
  <div class="tp-mini__track">
    <a class="tp-mini__card tp-mini__card--summary" href="{{ tp_url }}" target="_blank" rel="noopener">
      <span class="tp-mini__brand">{{ shop.name }}</span>
      {{ stars }}
      <span class="tp-mini__claim">{{ rating }} på Trustpilot · {{ count }} anmeldelser</span>
      <span class="tp-mini__logo">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="#00b67a" aria-hidden="true">
          <path d="M8 2.1l1.8 3.7 4.1.6-3 2.9.7 4.1L8 11.5l-3.6 1.9.7-4.1-3-2.9 4.1-.6L8 2.1Z"/>
        </svg>
        Trustpilot
      </span>
    </a>

    {%- for i in (1..3) -%}
      {%- liquid
        assign author_key = 'tp_review_' | append: i | append: '_author'
        assign headline_key = 'tp_review_' | append: i | append: '_headline'
        assign text_key = 'tp_review_' | append: i | append: '_text'
        assign author = settings[author_key]
        assign headline = settings[headline_key]
        assign text = settings[text_key]
      -%}
      {%- if text != blank or headline != blank -%}
        <article class="tp-mini__card">
          <div class="tp-mini__card-head">
            <span class="tp-mini__author">{{ author }}</span>
            {{ stars }}
          </div>
          {%- if headline != blank -%}
            <p class="tp-mini__headline">{{ headline }}</p>
          {%- endif -%}
          {%- if text != blank -%}
            <p class="tp-mini__text">{{ text }}</p>
          {%- endif -%}
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .tp-mini {
    width: 100%;
    padding: 4px 0 12px;
  }

  .tp-mini__track {
    display: flex;
    gap: 10px;
    padding-inline: var(--drawer-padding, 20px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .tp-mini__track::-webkit-scrollbar {
    display: none;
  }

  .tp-mini__card {
    flex: 0 0 78%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 14px;
    border-radius: 10px;
    background: rgb(217 217 217 / 0.2);
    color: inherit;
    text-decoration: none;
  }

  .tp-mini__card--summary {
    gap: 10px;
  }

  .tp-mini__brand {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .tp-mini__stars {
    display: inline-flex;
    gap: 2px;
  }

  .tp-mini__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    background: #00b67a;
  }

  .tp-mini__claim {
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .tp-mini__logo {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .tp-mini__card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .tp-mini__author {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .tp-mini__headline {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .tp-mini__text {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    opacity: 0.85;
  }

  @media screen and (min-width: 750px) {
    .tp-mini__card {
      flex-basis: 62%;
    }
  }
{% endstylesheet %}
