{%- if settings.mix_pack_enable and cart.empty? == false -%}
  {%- capture mix_pack_qty -%}{% render 'mix-pack-count' %}{%- endcapture -%}
  {%- liquid
    assign mix_pack_qty = mix_pack_qty | plus: 0
    assign qty_3 = settings.mix_pack_3_qty | default: 3
    assign qty_5 = settings.mix_pack_5_qty | default: 5
    assign price_3 = settings.mix_pack_3_price | default: '49' | times: 100
    assign price_5 = settings.mix_pack_5_price | default: '75' | times: 100
    assign scent_url = settings.cart_upsell_scents.url | default: routes.all_products_collection_url
    assign need_3 = qty_3 | minus: mix_pack_qty
    assign need_5 = qty_5 | minus: mix_pack_qty
  -%}
  {%- capture message -%}
    {%- if mix_pack_qty > 0 and mix_pack_qty < qty_3 -%}
      Tilføj {{ need_3 }} mere og betal kun {{ price_3 | money_without_trailing_zeros }} for {{ qty_3 }}-pack
    {%- elsif mix_pack_qty >= qty_3 and mix_pack_qty < qty_5 -%}
      {{ qty_3 }}-pack aktiv · tilføj {{ need_5 }} mere til {{ qty_5 }}-pack {{ price_5 | money_without_trailing_zeros }}
    {%- elsif mix_pack_qty >= qty_5 -%}
      {{ qty_5 }}-pack rabat er aktiv
    {%- endif -%}
  {%- endcapture -%}

  {%- if message != blank -%}
    <div class="mix-pack-nudge">
      <p class="mix-pack-nudge__text">{{ message }}</p>
      {%- if mix_pack_qty < qty_5 -%}
        <a class="mix-pack-nudge__link" href="{{ scent_url }}">Mix dine favoritter</a>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .mix-pack-nudge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    margin: 12px 0 4px;
    padding: 10px 12px;
    border-radius: 8px;
    background: #f3faf7;
    border: 1px solid #13a87733;
  }

  .cart-drawer .mix-pack-nudge {
    margin: 8px 24px 4px;
  }

  .mix-pack-nudge__text {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    font-weight: 600;
  }

  .mix-pack-nudge__link {
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    color: #13a877;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
{% endstylesheet %}
