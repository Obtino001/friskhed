{%- if settings.mix_pack_enable and cart.empty? == false -%}
  {%- capture mix_pack_qty -%}{% render 'mix-pack-count' %}{%- endcapture -%}
  {%- liquid
    assign mix_pack_qty = mix_pack_qty | plus: 0
    assign qty_10 = settings.mix_pack_10_qty | default: 10
    assign qty_15 = settings.mix_pack_15_qty | default: 15
    assign qty_30 = settings.mix_pack_30_qty | default: 30
    assign pct_10 = settings.mix_pack_10_pct | default: 5
    assign pct_15 = settings.mix_pack_15_pct | default: 10
    assign pct_30 = settings.mix_pack_30_pct | default: 15
    assign scent_url = settings.cart_upsell_scents.url | default: routes.all_products_collection_url
    assign need_10 = qty_10 | minus: mix_pack_qty
    assign need_15 = qty_15 | minus: mix_pack_qty
    assign need_30 = qty_30 | minus: mix_pack_qty
  -%}
  {%- capture message -%}
    {%- if mix_pack_qty > 0 and mix_pack_qty < qty_10 -%}
      Tilføj {{ need_10 }} mere og få {{ pct_10 }}% rabat
    {%- elsif mix_pack_qty >= qty_10 and mix_pack_qty < qty_15 -%}
      {{ pct_10 }}% aktiv · tilføj {{ need_15 }} mere til {{ pct_15 }}%
    {%- elsif mix_pack_qty >= qty_15 and mix_pack_qty < qty_30 -%}
      {{ pct_15 }}% aktiv · tilføj {{ need_30 }} mere til {{ pct_30 }}%
    {%- elsif mix_pack_qty >= qty_30 -%}
      {{ pct_30 }}% mængderabat er aktiv
    {%- endif -%}
  {%- endcapture -%}

  {%- if message != blank -%}
    <div class="mix-pack-nudge">
      <p class="mix-pack-nudge__text">{{ message }}</p>
      {%- if mix_pack_qty < qty_30 -%}
        <a class="mix-pack-nudge__link" href="{{ scent_url }}?mix=10">Mix dine favoritter</a>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .mix-pack-nudge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    margin: 12px 0 4px;
    padding: 10px 12px;
    border-radius: 8px;
    background: #f3faf7;
    border: 1px solid #13a87733;
  }

  .cart-drawer .mix-pack-nudge {
    margin: 8px 24px 4px;
  }

  .mix-pack-nudge__text {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    font-weight: 600;
  }

  .mix-pack-nudge__link {
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    color: #13a877;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
{% endstylesheet %}
