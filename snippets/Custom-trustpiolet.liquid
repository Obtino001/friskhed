



<div class="product-reviews">
  <a
    href="{{ block.settings.review_link }}"
    style="all: unset; cursor: pointer; display:flex; align-items: center; gap:6px;"
    target="_blank"
  >

    {% for i in (1..4) %}
      <svg height="18" width="18" viewBox="0 0 30 30">
        <path d="M28 30H2c-1.1 0-2-.9-2-2V2C0 .9.9 0 2 0h26c1.1 0 2 .9 2 2v26c0 1.1-.9 2-2 2z" fill="#579f78"/>
        <path d="M24.4 12.7c-.2-.5-.6-.9-1.1-1l-4.9-.7-2.1-4.3c-.4-.7-1.3-.9-2-.5-.2.1-.4.3-.5.5l-2.2 4.4-4.8.7c-.8.1-1.3.8-1.2 1.6 0 .3.2.6.4.8l3.5 3.4-.8 4.8c-.1.8.4 1.5 1.2 1.6.3.1.6 0 .9-.1l4.3-2.3 4.3 2.2c.7.4 1.5.1 1.9-.6.1-.3.2-.6.1-.9l-.8-4.8 3.5-3.4c.3-.3.4-.9.3-1.4z" fill="#fff"/>
      </svg>
    {% endfor %}

    <!-- Half star -->
    <svg height="18" width="18" viewBox="0 0 30 30">
      <path d="M15 30H2c-1.1 0-2-.9-2-2V2C0 .9.9 0 2 0h13" fill="#579f78"/>
      <path d="M15 0h13c1.1 0 2 .9 2 2v26c0 1.1-.9 2-2 2H15" fill="#b5b5b5"/>
      <path d="M24.4 12.7c-.2-.5-.6-.9-1.1-1l-4.9-.7-2.1-4.3c-.4-.7-1.3-.9-2-.5-.2.1-.4.3-.5.5l-2.2 4.4-4.8.7c-.8.1-1.3.8-1.2 1.6 0 .3.2.6.4.8l3.5 3.4-.8 4.8c-.1.8.4 1.5 1.2 1.6.3.1.6 0 .9-.1l4.3-2.3 4.3 2.2c.7.4 1.5.1 1.9-.6.1-.3.2-.6.1-.9l-.8-4.8 3.5-3.4c.3-.3.4-.9.3-1.4z" fill="#fff"/>
    </svg>

    {% if block.settings.rating_text != blank %}
      <div class="star-rating rte">
        {{ block.settings.rating_text }}
      </div>
    {% endif %}

    {% if block.settings.reviews_text != blank %}
      <div class="reviews-text rte">
        {{ block.settings.reviews_text }}
      </div>
    {% endif %}

  </a>
</div>
